{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/manual/warp-results/**/*.ts",
    "tests/manual/warp-results/**/*.vue"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
