{
  "name": "hsr-game-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "currency-wars": "node --import tsx scripts/currency-wars/cli.ts",
    "bench:currency-wars": "node --import tsx scripts/currency-wars/benchmark.ts",
    "extract:currency-wars": "node --import tsx scripts/currency-wars/data.ts",
    "validate:currency-wars": "node --import tsx scripts/currency-wars/data.ts --check",
    "extract:currency-wars-visuals": "node --import tsx scripts/currency-wars/visual-data.ts",
    "validate:currency-wars-visuals": "node --import tsx scripts/currency-wars/visual-data.ts --check",
    "extract:currency-wars-crafts": "node --import tsx scripts/currency-wars/craft-data.ts",
    "validate:currency-wars-crafts": "node --import tsx scripts/currency-wars/craft-data.ts --check",
    "verify:currency-wars-browser": "node --import tsx scripts/currency-wars/verify-browser-worker.ts",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "update:game-data": "node --import tsx scripts/update-game-data.ts",
    "validate:game-data": "node --import tsx scripts/validate-game-data.ts",
    "bench:engine": "node --import tsx scripts/benchmark-engine.ts",
    "validate:i18n": "node --import tsx scripts/validate-i18n.ts",
    "validate:planner-templates": "node --import tsx scripts/validate-planner-templates.ts",
    "update:warp-catalog": "node --import tsx scripts/warp-data/cli.ts update-catalog",
    "generate:warp-schema": "node --import tsx scripts/warp-data/cli.ts generate-schema",
    "find:warp-item": "node --import tsx scripts/warp-data/cli.ts find",
    "validate:warp-data": "node --import tsx scripts/warp-data/cli.ts validate",
    "build:warp-data": "node --import tsx scripts/warp-data/cli.ts build",
    "update:warp-visuals": "node --import tsx scripts/warp-visuals/cli.ts",
    "validate:warp-visuals": "node --import tsx scripts/warp-visuals/cli.ts --check",
    "sync:astral-ui": "node --import tsx scripts/ui/sync-astral-ui.ts",
    "validate:astral-ui": "node --import tsx scripts/ui/sync-astral-ui.ts --check"
  },
  "dependencies": {
    "@lucide/vue": "1.55.0",
    "@primeuix/themes": "2.0.3",
    "@vercel/analytics": "2.0.1",
    "highs": "1.15.3",
    "primevue": "4.5.5",
    "tailwindcss-primeui": "0.6.1",
    "vue": "3.5.43",
    "vue-i18n": "11.4.14",
    "vue-router": "4.6.4",
    "astral-ui": "file:vendor/astral-ui"
  },
  "devDependencies": {
    "@intlify/message-compiler": "11.4.14",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/tsconfig": "0.9.1",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.13"
  }
}
